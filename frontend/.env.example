# Variáveis de build do frontend (Vite). Copie para .env para desenvolvimento local.
# O Vite injeta estas variáveis NO BUILD (não em runtime) — só `VITE_*` é exposto ao cliente.

# Base da API. VAZIO = caminhos relativos (mesma origem) — use em DEV e no deploy
# self-hosted (Nginx serve a SPA e faz proxy de /api para o backend).
#
# Quando o frontend e o backend ficam em domínios diferentes (ex.: frontend no Vercel,
# backend no Railway), defina a URL pública do backend AQUI (sem barra no fim):
#   VITE_API_BASE=https://cultiva-backend.up.railway.app
# E libere essa origem do frontend no backend via CORS_ORIGINS.
VITE_API_BASE=
